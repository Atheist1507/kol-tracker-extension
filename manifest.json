{
  "manifest_version": 3,
  "name": "KOL Tracker",
  "version": "0.15.0",
  "description": "Research KOL/caller crypto ngay trên chart GMGN: ai đã post về token này, ai đáng tin, ghi chú thẳng vào Google Sheet.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.gmgn.cc/*",
    "https://gmgn.cc/*",
    "https://*.gmgn.ai/*",
    "https://gmgn.ai/*",
    "https://*.twitter.com/*",
    "https://twitter.com/*",
    "https://*.x.com/*",
    "https://x.com/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "KOL Tracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://gmgn.cc/*",
        "https://*.gmgn.cc/*"
      ],
      "js": [
        "src/lib/normalize.js",
        "src/lib/csv.js",
        "src/lib/tier.js",
        "src/lib/stats.js",
        "src/lib/model.js",
        "src/lib/gmgn.js",
        "src/lib/tooltip-text.js",
        "src/lib/geom.js",
        "src/lib/sheet-url.js",
        "src/lib/config.js",
        "src/lib/styles.js",
        "src/lib/render.js",
        "src/lib/ledger.js",
        "content/overlay.js",
        "content/note-box.js",
        "content/panel.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://gmgn.cc/*",
        "https://*.gmgn.cc/*"
      ],
      "js": [
        "content/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "src/lib/normalize.js",
        "src/lib/csv.js",
        "src/lib/tier.js",
        "src/lib/stats.js",
        "src/lib/model.js",
        "src/lib/gmgn.js",
        "src/lib/tooltip-text.js",
        "src/lib/sheet-url.js",
        "src/lib/x-page.js",
        "src/lib/config.js",
        "src/lib/styles.js",
        "src/lib/render.js",
        "src/lib/ca.js",
        "src/lib/ledger.js",
        "content/note-box.js",
        "content/x.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "Bật/tắt panel KOL Tracker (tra cả đoạn text đang bôi đen)"
    }
  }
}
